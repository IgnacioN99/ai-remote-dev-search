{
  "operator-mode-framework-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.claude/hooks/guard_framework.py --antigravity",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "apply-quality-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 ../.claude/hooks/apply_gate_stop.py --antigravity",
        "timeout": 120
      }
    ]
  }
}
